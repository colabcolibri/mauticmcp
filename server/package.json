{
  "name": "mautic-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "Local stdio MCP server for the Mautic v1 API",
  "type": "module",
  "bin": {
    "mautic-mcp": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node --env-file=.env dist/index.js",
    "test": "node --import tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.28.0",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0"
  }
}
