# Mautic site origin. A trailing /api is stripped.
MAUTIC_BASE_URL=https://mautic.example.com

# basic (self-hosted) or oauth
MAUTIC_AUTH=basic
MAUTIC_USERNAME=api
MAUTIC_PASSWORD=

# OAuth2 client_credentials. The body is form-encoded, not JSON.
# MAUTIC_CLIENT_ID=
# MAUTIC_CLIENT_SECRET=
# MAUTIC_TOKEN_URL=https://mautic.example.com/oauth/v2/token

# read is lookup only. operate creates, updates and deletes.
MAUTIC_MODE=read

# Both require operate. Delete defaults on. Send stays off.
MAUTIC_ALLOW_DELETE=true
MAUTIC_ALLOW_SEND=false
